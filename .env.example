# JobTrail (Next.js + PostgreSQL/Drizzle)
# Copy to .env.local:
#   cp .env.example .env.local

NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string used by lib/db/index.ts (Drizzle ORM) and
# drizzle.config.ts (drizzle-kit generate/migrate/push/studio).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/jobtrail

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Google SSO - the only way to create or sign in to a JobTrail account
# (jobseeker and employer). Create an OAuth 2.0 Client ID (Web application)
# in Google Cloud Console and add this app's origin(s) to
# "Authorized JavaScript origins". No redirect URI is needed since sign-in
# uses Google Identity Services' popup/One Tap flow, not the redirect flow.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID is exposed to the browser (it's meant to be
# public); GOOGLE_CLIENT_ID is used server-side to verify the ID token.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Optional - AI features return stubs without this
GROQ_API_KEY=

# Base URL of the JobTrail scraper API. Public external jobs are fetched live
# from this API and are not stored in JobTracker PostgreSQL. (default localhost)
SCRAPER_API_URL=http://localhost:8000

# Cloudinary - storage for CVs, cover letters and every other upload
# (server-only, never prefix with NEXT_PUBLIC_). Get these from
# Cloudinary Console > Settings > API Keys. Use EITHER the single URL form:
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# or the three separate variables:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
