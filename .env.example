# JobTrail (Next.js + PostgreSQL/Drizzle)
# Copy to .env.local:
#   cp .env.example .env.local

NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string used by lib/db/index.ts (Drizzle ORM) and
# drizzle.config.ts (drizzle-kit generate/migrate/push/studio).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/jobtrail

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Google SSO — the only way to create or sign in to a JobTrail account
# (jobseeker and employer). Create an OAuth 2.0 Client ID (Web application)
# in Google Cloud Console and add this app's origin(s) to
# "Authorized JavaScript origins". No redirect URI is needed since sign-in
# uses Google Identity Services' popup/One Tap flow, not the redirect flow.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID is exposed to the browser (it's meant to be
# public); GOOGLE_CLIENT_ID is used server-side to verify the ID token.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Optional — AI/CV features return stubs without this
GROQ_API_KEY=
